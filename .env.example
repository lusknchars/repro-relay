# Local development only. ./relay setup reads this file for newly started services.
# Direct API/Cargo commands read process environment.
DATABASE_URL=postgres://relay:relay_local_only@127.0.0.1:55478/relay
REPRO_PORT=8178
# Optional: both values must be set in the API process environment.
# REPRO_HERMES_URL=http://127.0.0.1:8642
# REPRO_HERMES_KEY=<the dedicated Hermes runtime API_SERVER_KEY>
# Optional phone sign-in. Configure a Twilio Verify service once per installation.
# These credentials belong on the server only, never in VITE_ variables.
# RELAY_TWILIO_ACCOUNT_SID=AC...
# RELAY_TWILIO_AUTH_TOKEN=...
# RELAY_TWILIO_VERIFY_SERVICE_SID=VA...
