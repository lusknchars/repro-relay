{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Repro Relay",
  "version": "0.2.0",
  "identifier": "com.reprorelay.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5178",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Repro Relay",
        "width": 1440,
        "height": 940,
        "minWidth": 780,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:8178 https://*.daily.co; frame-src https://*.daily.co; img-src 'self' data:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../../docs/licenses/daily-js.txt": "licenses/daily-js.txt"
    },
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
