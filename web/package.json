{
  "name": "repro-relay-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5178 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5178 --strictPort",
    "tauri": "tauri",
    "test:e2e": "playwright test",
    "test:guest": "playwright test --config playwright.guest.config.ts",
    "test:runner": "playwright test --config playwright.runner.config.ts",
    "test:compatibility": "playwright test --config playwright.compatibility.config.ts --project=chromium",
    "test:edge": "playwright test --config playwright.compatibility.config.ts --project=edge"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "gsap": "3.15.0",
    "lucide-react": "1.45.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.8.0",
    "tailwind-merge": "3.6.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
